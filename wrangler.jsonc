{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "09-prj-loreal-routine-builder",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://patte3am.github.io"
  },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
